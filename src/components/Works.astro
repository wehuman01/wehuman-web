---
interface Props {
  t: any;
}

const { t } = Astro.props;
const cards = t.works.cards as any[];

const hrefOf = (c: any) =>
  c.art === 'awedot' ? t.links.awedot_site : c.art === 'awewarm' ? '#install' : t.links.github_org;
const external = (c: any) => c.art !== 'awewarm';
---

<!-- 三张工具大卡：art 铺底 + 眉题/巨名/CTA + 悬停光弧 -->
<section id="works" class="hw-tools">
  <div class="hw-tools__head">
    <p class="hw-mono">{t.works.eyebrow}</p>
    <h2 class="hw-display hw-tools__title">{t.works.title}</h2>
  </div>

  <div class="hw-tools__grid">
    {cards.map((c: any) => (
      <a class="group hw-card hw-vignette" href={hrefOf(c)} target={external(c) ? '_blank' : undefined} rel={external(c) ? 'noopener' : undefined}>
        <span class="hw-arc" aria-hidden="true"></span>

        <div class="hw-card__art" aria-hidden="true">
          {c.art === 'awedot' && (
            <svg viewBox="0 0 627 547" fill="none" preserveAspectRatio="xMidYMid slice">
              <circle cx="468" cy="252" r="150" stroke="#F6F1E7" stroke-opacity="0.3" stroke-width="2.5"></circle>
              <circle cx="468" cy="252" r="108" stroke="#F6F1E7" stroke-opacity="0.12" stroke-width="1.5"></circle>
              <circle cx="468" cy="252" r="22" fill="#BC3A2C"></circle>
              <g stroke="#F6F1E7" stroke-opacity="0.2" stroke-width="2" stroke-linecap="round">
                <path d="M96 150 h180 M96 190 h130 M96 230 h160"></path>
                <path d="M120 380 C 220 360, 340 396, 460 372"></path>
              </g>
            </svg>
          )}
          {c.art === 'awewarm' && (
            <svg viewBox="0 0 627 547" fill="none" preserveAspectRatio="xMidYMid slice">
              <circle cx="313" cy="255" r="150" stroke="#F6F1E7" stroke-opacity="0.26" stroke-width="2.5" stroke-dasharray="3 10" stroke-linecap="round"></circle>
              <path d="M313 105 a150 150 0 0 1 130 226" stroke="#BC3A2C" stroke-width="4" stroke-linecap="round"></path>
              <circle cx="313" cy="255" r="14" fill="#BC3A2C"></circle>
              <path d="M443 255 h24 M429 175 l21 -12 M385 118 l14 -18" stroke="#F6F1E7" stroke-opacity="0.4" stroke-width="2" stroke-linecap="round"></path>
              <g stroke="#F6F1E7" stroke-opacity="0.18" stroke-width="2" stroke-linecap="round">
                <path d="M120 420 C 220 406, 420 430, 520 414"></path>
                <path d="M160 452 C 280 440, 400 460, 480 448" stroke-opacity="0.1"></path>
              </g>
            </svg>
          )}
          {c.art === 'wehuman' && (
            <svg viewBox="0 0 627 547" fill="none" preserveAspectRatio="xMidYMid slice">
              <path d="M313 108 C 210 118, 128 200, 130 296 C 132 396, 224 452, 318 444 C 420 436, 492 356, 486 262 C 480 176, 408 106, 313 108 C 266 109, 232 128, 208 158"
                stroke="#F6F1E7" stroke-opacity="0.32" stroke-width="3" stroke-linecap="round"></path>
              <rect x="286" y="236" width="56" height="56" rx="8" fill="#BC3A2C" fill-opacity="0.9"></rect>
              <path d="M305 278 v-22 M305 278 l10 -12 M305 278 l-10 -12 M323 258 v20" stroke="#F6F1E7" stroke-width="3" stroke-linecap="round"></path>
            </svg>
          )}
        </div>

        <div class="hw-card__body">
          <p class="hw-mono opacity-70">{c.eyebrow}</p>
          <h3 class="hw-card__name">{c.name}</h3>
          <p class="hw-mono hw-card__desc">{c.desc}</p>
          <span class="hw-btn hw-btn--paper">{c.cta}</span>
        </div>
      </a>
    ))}
  </div>
</section>
