---
interface Props {
  t: any;
}

const { t } = Astro.props;
const a = t.about_page;
const paragraphs = a.mission.text.split('\n\n');
---

<section class="px-6 py-20">
  <div class="mx-auto max-w-2xl">
    <p class="eyebrow">{a.label}</p>
    <h1 class="brush mt-4 text-5xl leading-tight text-ink md:text-6xl">{a.title}</h1>

    <h2 class="mt-16 font-serif text-xl font-semibold text-ink">{a.mission.title}</h2>
    <div class="mt-5 space-y-5 leading-loose text-ink/90">
      {paragraphs.map((p: string) => (
        <p>{p}</p>
      ))}
    </div>

    <h2 class="mt-16 font-serif text-xl font-semibold text-ink">{a.values.label}</h2>
    <div class="mt-6 space-y-6">
      {a.values.items.map((v: any) => (
        <div class="border-l-2 border-ink-line pl-5">
          <h3 class="font-serif text-lg font-semibold text-ink">{v.name}</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-light">{v.desc}</p>
        </div>
      ))}
    </div>

    <h2 class="mt-16 font-serif text-xl font-semibold text-ink">{a.contact.title}</h2>
    <a
      class="mt-5 flex items-center gap-4 no-underline transition-opacity hover:opacity-80"
      href={t.links.github_org}
      target="_blank"
      rel="noopener"
    >
      <span class="flex h-11 w-11 items-center justify-center rounded-md border border-ink-line text-ink-light">
        <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
      </span>
      <span>
        <span class="block font-semibold text-ink">{t.links.github_org.replace('https://', '')}</span>
        <span class="block text-sm text-ink-light">{a.contact.github_desc}</span>
      </span>
    </a>
  </div>
</section>
