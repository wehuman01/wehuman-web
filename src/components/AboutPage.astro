---
interface Props {
  t: any;
}

const { t } = Astro.props;
const a = t.about_page;
const paragraphs = a.mission.text.split('\n\n');
---

<!-- About：墨底巨题 + 纸面板排版，与首页同一体系 -->
<div>
  <section class="hw-about-hero hw-vignette">
    <div class="max-w-3xl">
      <p class="hw-mono reveal">{a.label}</p>
      <h1 class="hw-display hw-about-hero__title reveal" style="--rd:.08s">
        {a.title.map((line: string) => (
          <span class="block">{line}</span>
        ))}
      </h1>
    </div>
  </section>

  <section class="hw-about">
    <div class="hw-about__inner">
      <h2 class="reveal">{a.mission.title}</h2>
      {paragraphs.map((p: string) => (
        <p class="reveal">{p}</p>
      ))}

      <h2 class="reveal">{a.values.label}</h2>
      <div class="hw-about__values">
        {a.values.items.map((v: any, i: number) => (
          <div class="hw-about__value reveal" style={`--rd:${i * 0.08}s`}>
            <h3>{v.name}</h3>
            <p>{v.desc}</p>
          </div>
        ))}
      </div>

      <h2 class="reveal">{a.contact.title}</h2>
      <a
        class="mt-5 flex items-center gap-4 no-underline transition-opacity hover:opacity-80"
        href={t.links.github_org}
        target="_blank"
        rel="noopener"
      >
        <span class="flex h-11 w-11 items-center justify-center rounded-[4px] border border-[rgba(42,41,37,0.25)]">
          <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
        </span>
        <span>
          <span class="block font-bold">{t.links.github_org.replace('https://', '')}</span>
          <span class="hw-mono block mt-1 opacity-60">{a.contact.github_desc}</span>
        </span>
      </a>
    </div>

    <div class="hw-wordmark-end" aria-hidden="true">WEHUMAN</div>
  </section>
</div>
