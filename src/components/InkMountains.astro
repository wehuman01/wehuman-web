---
// 远山：两三叠低缓丘陵淡影，山脚漫一层烟雨雾带；随滚动轻微视差，如手卷徐徐展开
interface Props {
  flip?: boolean;
  class?: string;
}

const { flip = false, class: className = '' } = Astro.props;
---

<div class:list={['ink-mountains', className]} data-parallax="0.18">
  <svg
    viewBox="0 0 1440 240"
    preserveAspectRatio="none"
    aria-hidden="true"
    class="block h-28 w-full md:h-44"
    style={flip ? 'transform: scaleX(-1)' : ''}
  >
    <path fill="#37362F" opacity="0.03" d="M0 150 C 100 100, 220 84, 340 118 C 430 143, 520 148, 610 126 C 720 99, 830 92, 940 120 C 1050 147, 1160 146, 1260 122 C 1330 105, 1390 106, 1440 122 L1440 240 L0 240 Z"></path>
    <path fill="#37362F" opacity="0.05" d="M0 196 C 120 152, 260 142, 400 176 C 520 205, 650 206, 780 182 C 910 158, 1050 156, 1180 180 C 1280 198, 1370 196, 1440 186 L1440 240 L0 240 Z"></path>
    <path fill="#37362F" opacity="0.08" d="M0 224 C 150 190, 300 184, 460 206 C 620 227, 780 224, 940 204 C 1100 185, 1280 188, 1440 208 L1440 240 L0 240 Z"></path>
    <rect class="mist" x="0" y="186" width="1440" height="28" fill="#F6F1E7" opacity="0.5" filter="url(#ink-mist)"></rect>
    <rect class="mist" x="0" y="214" width="1440" height="22" fill="#F6F1E7" opacity="0.75" filter="url(#ink-mist)"></rect>
    <defs>
      <filter id="ink-mist" x="-5%" y="-120%" width="110%" height="340%">
        <feGaussianBlur stdDeviation="9"></feGaussianBlur>
      </filter>
    </defs>
  </svg>
</div>
