---
interface Props { mark: 'orbit' | 'ember' | 'network' }
const { mark } = Astro.props;
---

<div class:list={['product-mark', `product-mark--${mark}`]} aria-hidden="true">
  {mark === 'orbit' && (
    <svg viewBox="0 0 260 260">
      <circle class="mark-orbit" cx="130" cy="130" r="88" />
      <circle class="mark-orbit mark-orbit--inner" cx="130" cy="130" r="52" />
      <circle class="mark-core" cx="130" cy="130" r="13" />
      <path class="mark-trail" d="M43 141c49-27 116-45 176-20" />
    </svg>
  )}
  {mark === 'ember' && (
    <svg viewBox="0 0 260 260">
      <circle class="mark-wash" cx="130" cy="133" r="82" />
      <path class="mark-flame" d="M132 189c-39-1-61-29-52-62 7-25 29-37 36-65 25 19 13 43 30 55 10 8 17-4 18-18 22 24 29 52 12 72-10 12-25 18-44 18Z" />
      <path class="mark-heat" d="M73 214c37-8 75-8 114 0M91 229c26-5 52-5 78 0" />
    </svg>
  )}
  {mark === 'network' && (
    <svg viewBox="0 0 260 260">
      <path class="mark-current" d="M31 142c49-57 84 50 127-5 24-31 42-35 72-9" />
      <path class="mark-current mark-current--soft" d="M31 168c41-35 81 29 123-7 30-26 48-28 76-12" />
      <circle class="mark-node" cx="31" cy="142" r="8" />
      <circle class="mark-node" cx="102" cy="151" r="8" />
      <circle class="mark-node mark-node--accent" cx="158" cy="137" r="8" />
      <circle class="mark-node" cx="230" cy="128" r="8" />
    </svg>
  )}
</div>
