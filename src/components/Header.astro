---
import type { Locale, Section } from '../i18n/types';
import { en } from '../i18n/en';
import { zh } from '../i18n/zh';

interface Props {
  locale: Locale;
  current: Section;
  alternatePath: string;
}

const { locale, current, alternatePath } = Astro.props;
const t = locale === 'en' ? en : zh;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = locale === 'zh' ? '/zh' : '';
const items: Array<{ key: Section; path: string }> = [
  { key: 'home', path: `${prefix}/` },
  { key: 'research', path: `${prefix}/research/` },
  { key: 'philosophy', path: `${prefix}/philosophy/` },
  { key: 'articles', path: `${prefix}/articles/` },
];
---

<a class="skip-link" href="#main">{t.nav.skip}</a>
<header class="site-header" data-header>
  <a class="wordmark" href={`${base}${prefix}/`} aria-label="wehuman home">
    <span>we</span><em>human</em>
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    {items.map((item) => (
      <a href={`${base}${item.path}`} aria-current={current === item.key ? 'page' : undefined}>{t.nav[item.key]}</a>
    ))}
    <a class="language-link" href={`${base}${alternatePath}`} data-language-link data-language={locale === 'en' ? 'zh' : 'en'}>{t.nav.language}</a>
  </nav>
</header>
