---
import type { SiteCopy } from '../i18n/types';
import InkLandscape from './InkLandscape.astro';

interface Props { t: SiteCopy }
const { t } = Astro.props;
---

<section class="closing" aria-labelledby="closing-title">
  <div class="closing-inner reveal" data-reveal>
    <p class="eyebrow">{t.closing.eyebrow}</p>
    <h2 id="closing-title"><span>{t.closing.lineOne}</span><span>{t.closing.lineTwo}</span></h2>
    <p>{t.closing.body}</p>
    <a class="text-link" href="https://github.com/wehuman01" target="_blank" rel="noopener noreferrer">
      <span>{t.closing.github}</span>
      <svg viewBox="0 0 32 16" aria-hidden="true"><path d="M1 8h27m-7-6 7 6-7 6" /></svg>
    </a>
  </div>
  <InkLandscape variant="quiet" />
</section>
