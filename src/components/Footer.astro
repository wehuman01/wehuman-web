---
import type { SiteCopy } from '../i18n/types';

interface Props { t: SiteCopy }
const { t } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const languageHref = t.locale === 'en' ? `${basePath}/zh/` : `${basePath}/`;
---

<footer class="footer">
  <div class="seal" aria-label="wehuman seal">
    <svg viewBox="0 0 64 64" role="img" aria-hidden="true">
      <rect x="3" y="3" width="58" height="58" rx="4" />
      <path d="M18 17v29m0-15h13m0-14v29m0-15h14m0-14v29M31 17c8 5 11 14 14 29" />
    </svg>
  </div>
  <p>{t.footer.note}</p>
  <div class="footer-meta">
    <a href={languageHref} data-language-link data-language={t.locale === 'en' ? 'zh' : 'en'}>{t.footer.language}</a>
    <span>© {new Date().getFullYear()} wehuman</span>
  </div>
</footer>
