---
interface Props {
  t: any;
}

const { t } = Astro.props;
const items = t.features.items as any[];
---

<!-- 纸底特性面板：角标 + 六特性 + 巨型字标收尾 -->
<section id="features" class="hw-panel">
  <div class="hw-panel__tags" aria-hidden="true">
    <span class="hw-panel__tag">{t.features.tag1}</span>
    <span class="hw-panel__tag">{t.features.tag2}</span>
  </div>

  <div class="hw-feats">
    {items.map((f: any, i: number) => (
      <article class="hw-feat reveal">
        <div class={i % 2 === 1 ? 'hw-feat__text md:order-2' : 'hw-feat__text'}>
          <p class="hw-feat__no">{f.no} {f.key}</p>
          <h3 class="hw-display hw-feat__title">{f.title}</h3>
          <p class="hw-mono hw-feat__desc">{f.desc}</p>
        </div>

        <div class="hw-feat__art hw-noise" aria-hidden="true">
          {i === 0 && (
            <svg viewBox="0 0 666 574" fill="none" preserveAspectRatio="xMidYMid slice">
              <circle cx="333" cy="287" r="34" fill="#BC3A2C"></circle>
              <circle cx="333" cy="287" r="92" stroke="#F6F1E7" stroke-opacity="0.28" stroke-width="2"></circle>
              <circle cx="333" cy="287" r="150" stroke="#F6F1E7" stroke-opacity="0.14" stroke-width="1.5" stroke-dasharray="3 9"></circle>
              <g stroke="#F6F1E7" stroke-opacity="0.1" stroke-width="1.5"><line x1="60" y1="90" x2="200" y2="90"></line><line x1="90" y1="120" x2="230" y2="120"></line><line x1="470" y1="470" x2="610" y2="470"></line></g>
            </svg>
          )}
          {i === 1 && (
            <svg viewBox="0 0 666 574" fill="none" preserveAspectRatio="xMidYMid slice">
              <rect x="180" y="140" width="306" height="294" rx="10" stroke="#F6F1E7" stroke-opacity="0.3" stroke-width="2.5"></rect>
              <line x1="180" y1="180" x2="486" y2="180" stroke="#F6F1E7" stroke-opacity="0.16" stroke-width="2"></line>
              <path d="M270 300 a70 70 0 1 1 22 -50" stroke="#BC3A2C" stroke-width="4" stroke-linecap="round"></path>
              <path d="M292 250 l6 -28 l26 12 z" fill="#BC3A2C"></path>
              <g fill="#F6F1E7" fill-opacity="0.25"><rect x="210" y="380" width="120" height="8" rx="4"></rect><rect x="210" y="400" width="80" height="8" rx="4" fill-opacity="0.14"></rect></g>
            </svg>
          )}
          {i === 2 && (
            <svg viewBox="0 0 666 574" fill="none" preserveAspectRatio="xMidYMid slice">
              <circle cx="333" cy="287" r="130" stroke="#F6F1E7" stroke-opacity="0.2" stroke-width="2" stroke-dasharray="3 11" stroke-linecap="round"></circle>
              <path d="M333 157 a130 130 0 0 1 112 198" stroke="#BC3A2C" stroke-width="4.5" stroke-linecap="round"></path>
              <circle cx="333" cy="287" r="15" fill="#BC3A2C"></circle>
              <path d="M463 287 h26 M447 205 l24 -14 M387 138 l16 -22" stroke="#F6F1E7" stroke-opacity="0.35" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          )}
          {i === 3 && (
            <svg viewBox="0 0 666 574" fill="none" preserveAspectRatio="xMidYMid slice">
              <path d="M120 287 C 240 279, 420 295, 546 287" stroke="#F6F1E7" stroke-opacity="0.3" stroke-width="2.5" stroke-linecap="round"></path>
              <circle cx="333" cy="287" r="10" fill="#BC3A2C"></circle>
              <path d="M333 180 v-30 M333 394 v30 M226 287 h-30 M440 287 h30" stroke="#F6F1E7" stroke-opacity="0.16" stroke-width="1.5" stroke-linecap="round"></path>
              <path d="M250 200 l-22 -22 M416 374 l22 22 M416 200 l22 -22 M250 374 l-22 22" stroke="#F6F1E7" stroke-opacity="0.09" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          )}
          {i === 4 && (
            <svg viewBox="0 0 666 574" fill="none" preserveAspectRatio="xMidYMid slice">
              <path d="M283 287 h100" stroke="#F6F1E7" stroke-opacity="0.55" stroke-width="4" stroke-linecap="round"></path>
              <circle cx="333" cy="287" r="0.5" fill="#BC3A2C"></circle>
              <circle cx="333" cy="287" r="6" fill="#BC3A2C"></circle>
            </svg>
          )}
          {i === 5 && (
            <svg viewBox="0 0 666 574" fill="none" preserveAspectRatio="xMidYMid slice">
              <rect x="289" y="243" width="88" height="88" rx="12" fill="#BC3A2C"></rect>
              <rect x="299" y="253" width="68" height="68" rx="8" stroke="#F6F1E7" stroke-opacity="0.35" stroke-width="1.5"></rect>
              <path d="M322 305 v-32 M322 305 l16 -14 M322 305 l-16 -14 M346 277 v28" stroke="#F6F1E7" stroke-width="3.5" stroke-linecap="round"></path>
            </svg>
          )}
        </div>
      </article>
    ))}
  </div>

  <div class="hw-wordmark-end" aria-hidden="true">WEHUMAN</div>
  <div class="pb-[6vw]"></div>
</section>
