---
interface Props {
  t: any;
}

const { t } = Astro.props;
---

<!-- 预览框：粗墨边压住的 awedot 场景图（对应 Hermes 的视频区） -->
<section id="preview" class="hw-preview" aria-label={t.preview.label}>
  <div class="hw-preview__frame">
    <svg viewBox="0 0 1200 620" fill="none" role="img" aria-label={t.preview.label}>
      <rect width="1200" height="620" fill="#2A2925"></rect>

      <!-- 编辑器窗口 -->
      <g>
        <rect x="120" y="90" width="660" height="440" rx="8" fill="#FCF9F2" fill-opacity="0.04" stroke="#F6F1E7" stroke-opacity="0.22"></rect>
        <circle cx="152" cy="120" r="5" fill="#BC3A2C"></circle>
        <circle cx="172" cy="120" r="5" fill="#F6F1E7" fill-opacity="0.35"></circle>
        <circle cx="192" cy="120" r="5" fill="#F6F1E7" fill-opacity="0.35"></circle>
        <line x1="120" y1="146" x2="780" y2="146" stroke="#F6F1E7" stroke-opacity="0.14"></line>

        <!-- 代码行：不等长的纸色块 -->
        <g fill="#F6F1E7">
          <rect x="150" y="180" width="34" height="10" rx="2" fill-opacity="0.22"></rect>
          <rect x="196" y="180" width="220" height="10" rx="2" fill-opacity="0.5"></rect>
          <rect x="150" y="212" width="34" height="10" rx="2" fill-opacity="0.22"></rect>
          <rect x="196" y="212" width="160" height="10" rx="2" fill-opacity="0.5"></rect>
          <rect x="368" y="212" width="90" height="10" rx="2" fill-opacity="0.3"></rect>
          <rect x="150" y="244" width="34" height="10" rx="2" fill-opacity="0.22"></rect>
          <rect x="196" y="244" width="300" height="10" rx="2" fill-opacity="0.5"></rect>
          <rect x="150" y="276" width="34" height="10" rx="2" fill-opacity="0.22"></rect>
          <rect x="196" y="276" width="120" height="10" rx="2" fill-opacity="0.5"></rect>
          <rect x="330" y="276" width="180" height="10" rx="2" fill-opacity="0.3"></rect>
          <rect x="150" y="308" width="34" height="10" rx="2" fill-opacity="0.22"></rect>
          <rect x="196" y="308" width="250" height="10" rx="2" fill-opacity="0.5"></rect>
        </g>

        <!-- 光标 -->
        <rect x="196" y="340" width="10" height="14" fill="#BC3A2C"></rect>

        <!-- 终端面板 -->
        <rect x="150" y="390" width="440" height="104" rx="6" fill="#2A2925" stroke="#F6F1E7" stroke-opacity="0.18"></rect>
        <text x="172" y="432" fill="#BC3A2C" font-family="JetBrains Mono, monospace" font-size="20">$</text>
        <rect x="192" y="420" width="270" height="10" rx="2" fill="#F6F1E7" fill-opacity="0.45"></rect>
        <rect x="192" y="448" width="180" height="10" rx="2" fill="#F6F1E7" fill-opacity="0.25"></rect>
      </g>

      <!-- 会话收藏弧线：从窗口飞向悬浮球 -->
      <path d="M780 300 C 850 300, 880 260, 918 236" stroke="#BC3A2C" stroke-width="2" stroke-opacity="0.65" stroke-dasharray="2 7"></path>

      <!-- 悬浮球：屏幕右缘 -->
      <g>
        <circle cx="985" cy="218" r="88" fill="#2A2925" stroke="#F6F1E7" stroke-opacity="0.3" stroke-width="2"></circle>
        <circle cx="985" cy="218" r="64" stroke="#F6F1E7" stroke-opacity="0.14" stroke-width="1.5"></circle>
        <circle cx="985" cy="218" r="12" fill="#BC3A2C"></circle>
        <!-- 收藏条 -->
        <g fill="#F6F1E7" fill-opacity="0.7">
          <rect x="957" y="188" width="56" height="7" rx="3.5"></rect>
          <rect x="957" y="206" width="40" height="7" rx="3.5" fill-opacity="0.4"></rect>
          <rect x="957" y="224" width="48" height="7" rx="3.5" fill-opacity="0.4"></rect>
          <rect x="957" y="242" width="30" height="7" rx="3.5" fill-opacity="0.4"></rect>
        </g>
      </g>

      <!-- 底部水线 -->
      <g stroke="#F6F1E7" stroke-linecap="round">
        <path d="M120 570 C 300 562, 500 576, 700 568" stroke-opacity="0.16" stroke-width="2"></path>
        <path d="M160 592 C 380 584, 620 596, 860 588" stroke-opacity="0.08" stroke-width="2"></path>
      </g>
    </svg>
  </div>
</section>
