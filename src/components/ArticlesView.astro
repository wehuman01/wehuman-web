---
import type { CollectionEntry } from 'astro:content';
import type { SiteCopy } from '../i18n/types';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PageIntro from './PageIntro.astro';
import ArticleList from './ArticleList.astro';

interface Props { t: SiteCopy; articles: CollectionEntry<'articles'>[] }
const { t, articles } = Astro.props;
const prefix = t.locale === 'zh' ? '/zh' : '';
const canonicalPath = `${prefix}/articles/`;
const alternatePath = t.locale === 'en' ? '/zh/articles/' : '/articles/';
---

<Layout locale={t.locale} title={t.meta.articles.title} description={t.meta.articles.description} canonicalPath={canonicalPath} alternatePath={alternatePath}>
  <Header locale={t.locale} current="articles" alternatePath={alternatePath} />
  <main id="main" class="inner-page">
    <PageIntro eyebrow={t.articles.eyebrow} title={t.articles.title} intro={t.articles.intro} />
    <ArticleList locale={t.locale} articles={articles} />
  </main>
  <Footer locale={t.locale} />
</Layout>
