---
// Ink landscape for the home hero. Two independently drifting layers:
// the wash band and the vermilion sun. `data-drift` carries the pointer
// drift factors (px) consumed by scripts/motion.ts.
---

<div class="ink-layer" data-drift="9,5" aria-hidden="true">
  <svg viewBox="0 0 1440 340" preserveAspectRatio="none">
    <defs>
      <filter id="rough-ink">
        <feTurbulence type="fractalNoise" baseFrequency="0.012 0.09" numOctaves="3" seed="8" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="12" />
      </filter>
      <linearGradient id="ink-fade" x1="0" x2="1">
        <stop offset="0" stop-opacity=".08" />
        <stop offset=".28" stop-opacity=".72" />
        <stop offset=".76" stop-opacity=".38" />
        <stop offset="1" stop-opacity=".04" />
      </linearGradient>
    </defs>
    <path class="ink-wash" d="M-30 247C164 202 267 263 438 221c187-45 273-5 433 4 193 11 314-58 599-1v95H-30Z" filter="url(#rough-ink)" />
    <path class="ink-stroke" d="M-40 264c213-49 347 17 518-27 172-45 275 21 443 9 175-12 313-49 567-7" />
  </svg>
</div>
<div class="sun-layer" data-drift="-15,-9" aria-hidden="true">
  <span class="sun-dot"></span>
</div>
