---
interface Props { eyebrow: string; title: string; intro: string }
const { eyebrow, title, intro } = Astro.props;
---

<header class="page-intro reveal" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="page-lead">{intro}</p>
  <div class="brush-rule reveal-rule" data-reveal aria-hidden="true"></div>
</header>
