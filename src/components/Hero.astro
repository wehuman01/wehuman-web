---
import type { SiteCopy } from '../i18n/types';
import InkLandscape from './InkLandscape.astro';

interface Props { t: SiteCopy }
const { t } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="paper-fibres" aria-hidden="true"></div>
  <div class="hero-copy">
    <p class="eyebrow reveal" data-reveal>{t.hero.eyebrow}</p>
    <h1 id="hero-title" class="hero-title reveal" data-reveal>
      <span>{t.hero.lineOne}</span>
      <span>{t.hero.lineTwo}</span>
    </h1>
    <p class="hero-description reveal" data-reveal>{t.hero.description}</p>
    <a class="text-link hero-cta reveal" href="#products" data-reveal>
      <span>{t.hero.cta}</span>
      <svg viewBox="0 0 32 16" aria-hidden="true"><path d="M1 8h27m-7-6 7 6-7 6" /></svg>
    </a>
  </div>
  <div class="branch" aria-hidden="true">
    <svg viewBox="0 0 310 260">
      <path d="M-8 19c85 14 129 55 168 112 23 34 57 61 143 88" />
      <path d="M90 69c35-11 61-8 88 10M145 116c22-32 43-47 68-54" />
      <path class="leaf" d="M160 80c19-22 38-24 48-19-11 17-27 28-48 19Z" />
      <path class="leaf" d="M202 67c13-21 29-27 41-25-6 17-19 31-41 25Z" />
      <path class="leaf" d="M99 68c-15-17-29-20-41-15 8 14 22 22 41 15Z" />
    </svg>
  </div>
  <InkLandscape />
  <p class="river-note" aria-hidden="true">{t.hero.scroll} <span>↓</span></p>
</section>
