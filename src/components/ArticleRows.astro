---
import { articleHref, isoDate, type Article } from '../lib/data';
import type { Locale } from '../i18n/ui';

interface Props {
  entries: Article[];
  locale: Locale;
}
const { entries, locale } = Astro.props;
---

<div class="rows">
  {entries.map((entry) => (
    <a class="row" href={articleHref(locale, entry.data.path)}>
      <span class="row__meta" style="grid-column: 1 / 3; font-weight: 600; color: var(--color-ink);">{isoDate(entry.data.date)}</span>
      <span class="row__name" style="grid-column: 3 / 9; font-size: var(--text-md);">{entry.data.title}</span>
      <span class="row__desc" style="grid-column: 9 / 12;">{entry.data.description}</span>
      <span class="row__meta" style="grid-column: 12 / 13; text-align: end;" aria-hidden="true">→</span>
    </a>
  ))}
</div>
