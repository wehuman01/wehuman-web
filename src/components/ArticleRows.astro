---
import { articleHref, isoDate, type Article } from '../lib/data';
import type { Locale } from '../i18n/ui';

interface Props {
  entries: Article[];
  locale: Locale;
}
const { entries, locale } = Astro.props;
---

<div class="rows">
  {entries.map((entry) => (
    <a class="row row--doc" href={articleHref(locale, entry.data.path)}>
      <span class="row__meta row__date">{isoDate(entry.data.date)}</span>
      <span class="row__name">{entry.data.title}</span>
      <span class="row__desc">{entry.data.description}</span>
      <span class="row__meta row__go" aria-hidden="true">→</span>
    </a>
  ))}
</div>
