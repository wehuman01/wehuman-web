---
interface Props {
  t: any;
  lang: string;
}

const { t, lang } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const aboutHref = `${basePath}${lang === 'zh' ? '/zh/about' : '/about'}`;
const rows = t.philosophy.rows as { pre: string; key: string; post: string }[];
const badges = t.philosophy.badges as string[];
---

<!-- 跋尾：居中宣言，朱字点睛，徽记一行，关于收束 -->
<section class="closing" data-scroll-fade>
  <p class="eyebrow">{t.philosophy.label}</p>
  <div class="closing-rows">
    {rows.map((row: any) => (
      <p class="closing-row">
        {row.pre}<span class="closing-key">{row.key}</span>{row.post}
      </p>
    ))}
  </div>
  <div class="closing-badges">
    {badges.map((badge: string) => (
      <span class="closing-badge">{badge}</span>
    ))}
  </div>
  <a class="ink-link" href={aboutHref}>{t.about_bridge} →</a>
</section>
