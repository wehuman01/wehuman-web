---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/types';
import { en } from '../i18n/en';
import { zh } from '../i18n/zh';

interface Props { locale: Locale; articles: CollectionEntry<'articles'>[] }
const { locale, articles } = Astro.props;
const t = locale === 'en' ? en : zh;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = locale === 'zh' ? '/zh' : '';
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
---

<div class="article-list">
  {articles.map((article, index) => (
    <article class="article-row reveal" data-reveal>
      <div class="article-meta">
        <time datetime={article.data.date.toISOString()}>{article.data.date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        {index === 0 && <span>{t.articles.latest}</span>}
      </div>
      <div class="article-summary">
        <h2><a href={`${base}${prefix}/articles/${article.data.path}/`}>{article.data.title}</a></h2>
        <p>{article.data.description}</p>
        <ul aria-label="Topics">{article.data.tags.map((tag) => <li>{tag}</li>)}</ul>
        <a class="arrow-link" href={`${base}${prefix}/articles/${article.data.path}/`}>{t.articles.read}<span aria-hidden="true">↗</span></a>
      </div>
    </article>
  ))}
</div>
