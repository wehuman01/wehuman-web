---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import ArticleView from '../../../components/ArticleView.astro';
import { zh } from '../../../i18n/zh';

export const getStaticPaths = (async () => {
  const articles = await getCollection('articles', ({ data }) => data.locale === 'zh');
  return articles.map((article) => ({ params: { slug: article.data.path }, props: { article } }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
---

<ArticleView t={zh} article={article} />
