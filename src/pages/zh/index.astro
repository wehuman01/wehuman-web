---
import Layout from '../../layouts/Layout.astro';
import ScrollOpening from '../../components/ScrollOpening.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Works from '../../components/Works.astro';
import Features from '../../components/Features.astro';
import Philosophy from '../../components/Philosophy.astro';
import InkMountains from '../../components/InkMountains.astro';
import Footer from '../../components/Footer.astro';
import t from '../../i18n/zh.json';
---

<Layout title={`${t.site.title} — ${t.site.tagline}`} lang="zh" description={t.site.description}>
  <ScrollOpening />
  <Header t={t} lang="zh" current="home" />
  <main>
    <Hero t={t} />
    <Works t={t} />
    <Features t={t} />
    <Philosophy t={t} lang="zh" />
    <div class="interlude" aria-hidden="true">
      <InkMountains class="absolute inset-x-0 bottom-0" />
    </div>
  </main>
  <Footer t={t} lang="zh" />
</Layout>
