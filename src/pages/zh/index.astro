---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Philosophy from '../../components/Philosophy.astro';
import ProductStory from '../../components/ProductStory.astro';
import ClosingStatement from '../../components/ClosingStatement.astro';
import Footer from '../../components/Footer.astro';
import { zh } from '../../i18n/zh';
---

<Layout lang="zh" title={zh.meta.title} description={zh.meta.description} canonicalPath="/zh/">
  <Header t={zh} />
  <main id="main">
    <Hero t={zh} />
    <Philosophy t={zh} />
    <ProductStory t={zh} />
    <ClosingStatement t={zh} />
  </main>
  <Footer t={zh} />
</Layout>
