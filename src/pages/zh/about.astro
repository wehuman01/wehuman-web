---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import AboutPage from '../../components/AboutPage.astro';
import Footer from '../../components/Footer.astro';
import t from '../../i18n/zh.json';
---

<Layout title={`${t.about_page.title} · wehuman`} lang="zh" description={t.site.description}>
  <Header t={t} lang="zh" current="about" />
  <main>
    <AboutPage t={t} />
  </main>
  <Footer t={t} />
</Layout>
