---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import ArticleView from '../../components/ArticleView.astro';
import { en } from '../../i18n/en';

export const getStaticPaths = (async () => {
  const articles = await getCollection('articles', ({ data }) => data.locale === 'en');
  return articles.map((article) => ({ params: { slug: article.data.path }, props: { article } }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
---

<ArticleView t={en} article={article} />
