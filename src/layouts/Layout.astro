---
import '../styles/global.css';

interface Props {
  title: string;
  lang: string;
  description?: string;
}

const { title, lang, description = '' } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..700;1,400..600&family=JetBrains+Mono:wght@500&family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // 动效标记：JS 可用才启用动画初态；同一会话已展过卷轴则跳过开场
      document.documentElement.classList.add('js');
      try {
        if (sessionStorage.getItem('wehuman-opened')) {
          document.documentElement.classList.add('no-opening');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="paper-wash min-h-screen overflow-x-hidden bg-paper font-serif text-ink antialiased">
    <slot />
    <script src="../scripts/ink-motion.js"></script>
  </body>
</html>
