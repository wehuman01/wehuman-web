---
import Base from '../layouts/Base.astro';
import { ui, type Locale } from '../i18n/ui';
import { url } from '../lib/base';

interface Props { locale: Locale; altHref: string; }
const { locale, altHref } = Astro.props;
const t = ui[locale];
const prefix = url(locale === 'zh' ? '/zh' : '');
---

<Base locale={locale} title={t.meta.home.title} description={t.meta.home.description} altHref={altHref} active="home">
  <!-- opening · statement, subline, one CTA — nothing else -->
  <section class="band home-hero">
    <div class="grid12">
      <h1 class="display" style="grid-column: 1 / 13;">
        {t.home.display.map((line) => <span class="display-line">{line}</span>)}
      </h1>
      <p class="lede prose" style="grid-column: 1 / 9; margin-block-start: var(--space-lg);">{t.home.lede}</p>
      <p style="grid-column: 1 / 13; margin-block-start: var(--space-2xl);">
        <a class="cta" href={`${prefix}/product/`}>{t.home.cta}</a>
      </p>
    </div>
  </section>
</Base>
