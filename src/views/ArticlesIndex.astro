---
import Base from '../layouts/Base.astro';
import ArticleRows from '../components/ArticleRows.astro';
import { ui, type Locale } from '../i18n/ui';
import { getArticles } from '../lib/data';

interface Props { locale: Locale; altHref: string; }
const { locale, altHref } = Astro.props;
const t = ui[locale];
const articles = await getArticles(locale);

// one group per product, newest product first; anything unlisted falls in last
const productOrder = ['awerouter', 'aweshare', 'aweswitch', 'awewarm', 'aweskill', 'aweshelf'];
const rest = [...new Set(articles.map((a) => a.data.product))].filter((p) => !productOrder.includes(p));
const groups = [...productOrder, ...rest]
  .map((product) => ({ product, items: articles.filter((a) => a.data.product === product) }))
  .filter((g) => g.items.length > 0);
---

<Base locale={locale} title={t.meta.articles.title} description={t.meta.articles.description} altHref={altHref} active="articles">
  <section class="band">
    <div class="grid12">
      <div style="grid-column: 1 / 9;">
        <h1 class="display-s">{t.articles.display}</h1>
        <p class="lede prose" style="margin-block-start: var(--space-lg);">{t.articles.lede}</p>
      </div>
    </div>
  </section>

  <nav class="sec-index" id="contents" aria-label={t.sections.navLabel}>
    <div class="grid12">
      <div class="sec-index__inner" style="grid-column: 1 / 13;">
        <p class="label">{t.sections.label}</p>
        <ul>
          {groups.map((group) => (
            <li>
              <a class="sec-index__link" href={`#${group.product}`}>{group.product}</a>
              <span class="sec-count">{group.items.length}</span>
            </li>
          ))}
        </ul>
        <button class="sec-index__all" data-sections-all data-expand-label={t.sections.expandAll} data-collapse-label={t.sections.collapseAll}>{t.sections.expandAll}</button>
      </div>
    </div>
  </nav>

  <section class="band--tight">
    <div class="grid12">
      {groups.map((group) => (
        <details class="sec-group" id={group.product} style="grid-column: 1 / 13;">
          <summary class="sec-group__head">
            <span class="sec-group__title"><span class="label">{group.product}</span></span>
            <span class="sec-count">{group.items.length}</span>
            <span class="sec-group__glyph" aria-hidden="true">+</span>
          </summary>
          <div class="sec-group__body">
            <ArticleRows entries={group.items} locale={locale} />
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="band--tight">
    <div class="grid12">
      <p style="grid-column: 1 / 13; padding-block: var(--space-lg);">
        <a class="tlink" href="#contents">{t.sections.toIndex}</a>
      </p>
    </div>
  </section>
</Base>

<script src="../scripts/sections.js"></script>
